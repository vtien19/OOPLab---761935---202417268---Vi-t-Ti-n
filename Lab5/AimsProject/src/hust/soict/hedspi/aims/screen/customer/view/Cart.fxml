<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1024.0"
            prefHeight="768.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hust.soict.hedspi.aims.screen.customer.controller.CartController">

    <top>
        <HBox alignment="CENTER"
              prefHeight="100.0"
              style="-fx-border-color: red; -fx-border-width: 2;">
            <padding>
                <Insets left="20.0" right="20.0"/>
            </padding>

            <children>
                <Label text="Cart"
                       textFill="#004cff"
                       style="-fx-font-size: 50px;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="View Store"
                        prefWidth="100.0"
                        prefHeight="50.0"
                        onAction="#btnViewStorePressed"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER"
              style="-fx-border-color: red; -fx-border-width: 2;">
            <padding>
                <Insets left="20.0" right="20.0"/>
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT"
                      spacing="10.0">
                    <padding>
                        <Insets top="10.0" bottom="10.0"/>
                    </padding>

                    <children>
                        <Label text="Filter"/>

                        <TextField fx:id="tfFilter"
                                   prefWidth="180.0"/>

                        <RadioButton fx:id="radioBtnFilterId"
                                     text="By ID"
                                     selected="true">
                            <toggleGroup>
                                <ToggleGroup fx:id="filterCategory"/>
                            </toggleGroup>
                        </RadioButton>

                        <RadioButton fx:id="radioBtnFilterTitle"
                                     text="By Title"
                                     toggleGroup="$filterCategory"/>
                    </children>
                </HBox>

                <TableView fx:id="tblMedia"
                           prefHeight="400.0"
                           prefWidth="980.0">
                    <columns>
                        <TableColumn fx:id="colMediaId"
                                     text="ID"
                                     prefWidth="100.0"/>

                        <TableColumn fx:id="colMediaTitle"
                                     text="Title"
                                     prefWidth="380.0"/>

                        <TableColumn fx:id="colMediaCategory"
                                     text="Category"
                                     prefWidth="300.0"/>

                        <TableColumn fx:id="colMediaCost"
                                     text="Cost"
                                     prefWidth="190.0"/>
                    </columns>
                </TableView>

                <HBox alignment="TOP_RIGHT"
                      spacing="20.0">
                    <padding>
                        <Insets top="10.0"/>
                    </padding>

                    <children>
                        <Button fx:id="btnPlay"
                                text="Play"
                                prefWidth="60.0"
                                onAction="#btnPlayPressed"/>

                        <Button fx:id="btnRemove"
                                text="Remove"
                                prefWidth="80.0"
                                onAction="#btnRemovePressed"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="TOP_CENTER"
              spacing="30.0"
              prefHeight="200.0"
              style="-fx-border-color: red; -fx-border-width: 2;">

            <children>
                <HBox alignment="CENTER"
                      spacing="10.0">
                    <children>
                        <Label text="Total:"
                               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

                        <Label fx:id="costLabel"
                               text="0.0 $"
                               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </children>
                </HBox>

                <Button text="Place Order"
                        textFill="WHITE"
                        style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-background-color: #004cff;"
                        onAction="#btnPlaceOrderPressed"/>
            </children>
        </VBox>
    </bottom>

</BorderPane>